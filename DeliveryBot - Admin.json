        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0 && r.id_pedido);\nconst now = $now;\nconst p2 = n => String(n).padStart(2, '0');\nconst hoy = p2(now.day) + '/' + p2(now.month) + '/' + now.year;\nconst hoyRows = rows.filter(r => String(r.fecha) === hoy);\nlet total = 0;\nconst prodQty = {};\nconst horaCount = {};\nfor (const r of hoyRows) {\n  total += Number(r.total_pago || 0);\n  let cart = [];\n  try { cart = r.detalles_pedido ? JSON.parse(r.detalles_pedido) : []; } catch (e) { cart = []; }\n  for (const it of cart) {\n    const nombre = it.nombre || it.id_producto || 'desconocido';\n    prodQty[nombre] = (prodQty[nombre] || 0) + Number(it.cantidad || 0);\n  }\n  const h = String(r.hora || '').split(':')[0];\n  if (h !== '') horaCount[h] = (horaCount[h] || 0) + 1;\n}\nlet estrella = '—'; let maxQty = 0;\nfor (const k of Object.keys(prodQty)) { if (prodQty[k] > maxQty) { maxQty = prodQty[k]; estrella = k; } }\nlet horaPico = '—'; let maxH = 0;\nfor (const k of Object.keys(horaCount)) { if (horaCount[k] > maxH) { maxH = horaCount[k]; horaPico = k; } }\nif (horaPico !== '—') { horaPico = p2(horaPico) + ':00 - ' + p2((Number(horaPico) + 1) % 24) + ':00'; }\nconst texto = 'Reporte de hoy DeliveryBot\\n' +\n  'Fecha: ' + hoy + '\\n' +\n  'Total vendido: $' + total.toLocaleString('es-CO') + '\\n' +\n  'Pedidos: ' + hoyRows.length + '\\n' +\n  'Producto estrella: ' + estrella + '\\n' +\n  'Hora pico: ' + horaPico;\nreturn [{ json: { texto } }];"
      },
