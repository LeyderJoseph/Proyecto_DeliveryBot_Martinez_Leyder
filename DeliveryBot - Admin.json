      "notes": "Escucha mensajes del bot de ADMINISTRACIÓN (bot distinto al de clientes, token distinto, credencial 'DeliveryBot Telegram Admin')."
    },
    {
      "parameters": {
        "jsCode": "const upd = $json;\nconst cq = upd.callback_query;\nconst msg = cq ? cq.message : upd.message;\nconst from = cq ? cq.from : (upd.message ? upd.message.from : {});\nconst chat_id = msg && msg.chat ? msg.chat.id : (from ? from.id : null);\nconst telegram_id = String(from && from.id ? from.id : '');\nconst nombre_usuario = [from && from.first_name, from && from.last_name].filter(Boolean).join(' ');\nlet raw = cq ? String(cq.data || '') : String((upd.message && upd.message.text) || '').trim();\nlet action = 'UNKNOWN';\nlet param = '';\nif (cq) {\n  if (raw === 'START') action = 'START';\n  else if (raw === 'PENDING') action = 'PENDING';\n  else if (raw.indexOf('ORDER:') === 0) { action = 'ORDER'; param = raw.slice(6); }\n  else if (raw.indexOf('SETSTATUS:') === 0) { action = 'SETSTATUS'; param = raw.slice(10); }\n  else if (raw === 'REPORT') action = 'REPORT';\n} else {\n  const t = raw.toLowerCase();\n  if (t === '/start' || t === 'start' || t === 'hola' || t === 'inicio') action = 'START';\n  else if (t.indexOf('pendientes') !== -1 || t.indexOf('pedidos') !== -1) action = 'PENDING';\n  else if (t.indexOf('reporte') !== -1) action = 'REPORT';\n  else if (/^ord-\\d{8}-\\d{6}$/i.test(raw.trim())) { action = 'ORDER'; param = raw.trim().toUpperCase(); }\n}\nreturn [{ json: { chat_id, telegram_id, nombre_usuario, action, param, raw, now: new Date().toISOString() } }];"
      },
