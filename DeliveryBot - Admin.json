    {
      "parameters": {
        "jsCode": "const pedidos = items.map(i => i.json).filter(p => p.id_pedido && p.estado !== 'Entregado');\nif (pedidos.length === 0) {\n  return [{ json: { texto: 'No hay pedidos pendientes en este momento.' } }];\n}\nlet texto = 'Pedidos pendientes:\\n\\n';\nfor (const p of pedidos) {\n  texto += `${p.id_pedido} - ${p.estado} - $${Number(p.total_pago).toLocaleString('es-CO')}\\n`;\n}\ntexto += '\\nEscribe el número de orden que quieres ver, por ejemplo: ' + pedidos[0].id_pedido;\nreturn [{ json: { texto } }];"
      },
