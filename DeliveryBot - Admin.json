    {
      "parameters": {
        "jsCode": "const p = items[0] ? items[0].json : null;\nif (!p) return [{ json: { texto: 'No encontré ese pedido.', encontrado: false } }];\n\nlet detalleTexto = p.detalles_pedido;\ntry {\n  const productos = JSON.parse(p.detalles_pedido);\n  detalleTexto = productos.map(i => '• ' + i.nombre + ' x' + i.cantidad + ' — $' + Number(i.precio * i.cantidad).toLocaleString('es-CO')).join('\\n');\n} catch (e) {}\n\nconst emojiEstado = { 'Recibido': '🆕', 'Preparación': '👨‍🍳', 'En camino': '🛵', 'Entregado': '📦' };\nconst emoji = emojiEstado[p.estado] || '📋';\n\nconst texto = `${emoji} *Pedido ${p.id_pedido}*\\n👤 ${p.nombre_usuario}\\n\\n🧾 Detalle:\\n${detalleTexto}\\n\\n💰 *Total: $${Number(p.total_pago).toLocaleString('es-CO')}*\\n📍 Estado actual: *${p.estado}*`;\n\nreturn [{ json: { texto, encontrado: true } }];"
      },
